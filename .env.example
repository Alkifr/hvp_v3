DATABASE_URL="postgresql://hangar:hangar@localhost:5432/hangar_planning?schema=public"
DATABASE_CLOUD_URL="postgresql://hangar:hangar@localhost:5432/hangar_planning?schema=public"
TZ="Europe/Moscow"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="change_me_dev_secret_use_24plus_in_production"

# Локальная разработка: демо-пользователи и демо-справочники (в production игнорируется / запрещён)
SEED_DEMO=1
ADMIN_EMAIL="admin@local.dev"
ADMIN_PASSWORD="admin"
ADMIN_NAME="Администратор"

# PORT не задавайте: npm start → :3000, npm run dev → API :3001
#
# Production:
# NODE_ENV=production
# JWT_SECRET=случайная_строка_не_короче_24_символов
# CORS_ORIGINS=
# ADMIN_EMAIL / ADMIN_PASSWORD — обязательны, не demo-значения
# SEED_DEMO не задавать
# COOKIE_SECURE=0 — только если стенд по HTTP без TLS
# HOST=127.0.0.1 — если API за reverse proxy (HTTPS)
