generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_CLOUD_URL")
}

enum PlanningLevel {
  STRATEGIC
  OPERATIONAL
}

enum EventStatus {
  PENDING_EXECUTOR_APPROVAL
  PENDING_CUSTOMER_APPROVAL
  APPROVED_BY_EXECUTOR
  APPROVED_BY_CUSTOMER
  IN_PROGRESS
  DONE
  CANCELLED
  DELETED
}

enum EventPlanningKind {
  PLANNED
  UNPLANNED
}

/// Контур ТО: L (Line) / B (Base)
enum EventLineBase {
  LINE
  BASE
}

enum EventPlacementOrigin {
  MANUAL
  AUTO_GAP
}

enum EventAuditAction {
  CREATE
  UPDATE
  RESERVE
  UNRESERVE
}

enum UserActivityAction {
  SANDBOX_CREATE
  SANDBOX_DELETE
  CLEANUP
}

enum TechnicalPlanStatus {
  DRAFT
  IN_REVIEW
  READY
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TechnicalNeedCategory {
  PERSONNEL
  MATERIAL
  TOOL
  DOCUMENTATION
  EQUIPMENT
  CONTRACTOR
  OTHER
}

enum TechnicalNeedStatus {
  NEEDED
  REQUESTED
  IN_PROGRESS
  READY
  BLOCKED
  CANCELLED
}

enum TechnicalStepStatus {
  NOT_STARTED
  READY
  IN_PROGRESS
  BLOCKED
  DONE
  SKIPPED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

// Узкий/широкий фюзеляж — для подбора варианта расстановки под типы ВС
enum BodyType {
  NARROW_BODY // узкий (A320, B737, …)
  WIDE_BODY // широкий (A330, B777, …)
}

enum OptimizationScoreCategory {
  REWARD
  PENALTY
  LIMIT
}

enum OptimizationScoreUnit {
  POINTS
  POINTS_PER_HOUR
  HOURS
  BOOLEAN
  MULTIPLIER
}

enum OptimizationScoreScope {
  NEW_EVENT
  EXISTING_EVENT
  PLACEMENT
  LAYOUT
  STAND
  TOW
  PRIORITY
}

// Роль пользователя в песочнице плана
enum SandboxMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum SandboxStatus {
  ACTIVE
  ARCHIVED
}

enum ReportShareRole {
  VIEWER
  EDITOR
}

enum PrimaryMetricBlock {
  WP_PLAN_MPS
  WP_ACTUAL
  FIXED_COST_PLAN
  TM_PLAN
  ACCESS_LABOR_PLAN
  NRC_PLAN
  ADD_PLAN
  FIXED_COST_ACTUAL
  TM_ACTUAL
  NRC_ACTUAL
  ADD_ACTUAL
  LABOR_BUDGET
}

enum PrimaryMetricDepartment {
  ME
  AV
  INT
  NDT
  SHOP
  CAB_REP
}

enum PrimaryMetricSource {
  MANUAL
  IMPORT
  MPS
  SAP
}

model Shift {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  // минуты от полуночи (локальные)
  startMin  Int
  endMin    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planLines   EventWorkPlanLine[]
  actualLines EventWorkActualLine[]
  timeEntries TimeEntry[]

  @@index([isActive])
}

model Person {
  id        String   @id @default(uuid())
  code      String?  @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills         PersonSkill[]
  timeEntries    TimeEntry[]
  unavailability PersonUnavailability[]

  @@index([isActive])
}

model Skill {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people      PersonSkill[]
  planLines   EventWorkPlanLine[]
  actualLines EventWorkActualLine[]
  timeEntries TimeEntry[]

  @@index([isActive])
}

model PersonSkill {
  personId  String
  skillId   String
  level     Int?
  validFrom DateTime?
  validTo   DateTime?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([personId, skillId])
  @@index([skillId])
}

model PersonUnavailability {
  id        String   @id @default(uuid())
  personId  String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, startAt, endAt])
}

model EventWorkPlanLine {
  id               String   @id @default(uuid())
  eventId          String
  // контекст планирования: null = рабочий контур, иначе — песочница
  sandboxId        String?
  date             DateTime // начало суток (UTC) для планирования по дням
  shiftId          String
  skillId          String
  // потребность: сколько людей нужно на смену по квалификации
  plannedHeadcount Int?
  plannedMinutes   Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shift   Shift            @relation(fields: [shiftId], references: [id])
  skill   Skill            @relation(fields: [skillId], references: [id])
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([eventId, date, shiftId, skillId])
  @@index([eventId, date])
  @@index([skillId])
  @@index([shiftId])
  @@index([sandboxId])
}

model EventWorkActualLine {
  id              String   @id @default(uuid())
  eventId         String
  sandboxId       String?
  date            DateTime // начало суток (UTC)
  shiftId         String
  skillId         String
  actualHeadcount Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shift   Shift            @relation(fields: [shiftId], references: [id])
  skill   Skill            @relation(fields: [skillId], references: [id])
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([eventId, date, shiftId, skillId])
  @@index([eventId, date])
  @@index([skillId])
  @@index([shiftId])
  @@index([sandboxId])
}

model TimeEntry {
  id        String   @id @default(uuid())
  eventId   String
  sandboxId String?
  personId  String
  skillId   String
  shiftId   String?
  startAt   DateTime
  endAt     DateTime
  minutes   Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person  Person           @relation(fields: [personId], references: [id])
  skill   Skill            @relation(fields: [skillId], references: [id])
  shift   Shift?           @relation(fields: [shiftId], references: [id])
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([eventId, startAt])
  @@index([personId, startAt])
  @@index([skillId])
  @@index([sandboxId])
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements    StockMovement[]
  reservations MaterialReservation[]
  issues       MaterialIssue[]

  @@index([isActive])
}

model Material {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  uom       String // например "EA", "KG"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements    StockMovement[]
  reservations MaterialReservation[]
  issues       MaterialIssue[]

  @@index([isActive])
}

model StockMovement {
  id          String            @id @default(uuid())
  materialId  String
  warehouseId String
  type        StockMovementType
  qty         Float
  eventId     String?
  sandboxId   String?
  notes       String?
  createdAt   DateTime          @default(now())

  material  Material          @relation(fields: [materialId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  event     MaintenanceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sandbox   Sandbox?          @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([warehouseId, materialId, createdAt])
  @@index([eventId])
  @@index([sandboxId])
}

model MaterialReservation {
  id          String   @id @default(uuid())
  eventId     String
  sandboxId   String?
  materialId  String
  warehouseId String
  qtyReserved Float
  needByDate  DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  material  Material         @relation(fields: [materialId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  sandbox   Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([eventId, materialId, warehouseId, needByDate])
  @@index([eventId, needByDate])
  @@index([warehouseId, materialId])
  @@index([sandboxId])
}

model MaterialIssue {
  id          String   @id @default(uuid())
  eventId     String
  sandboxId   String?
  materialId  String
  warehouseId String
  qtyIssued   Float
  issuedAt    DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  material  Material         @relation(fields: [materialId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  sandbox   Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([eventId, issuedAt])
  @@index([warehouseId, materialId])
  @@index([sandboxId])
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  displayName        String?
  passwordHash       String
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?
  /// Инкремент инвалидирует все JWT этого пользователя.
  tokenVersion       Int      @default(0)
  /// Стартовый раздел SPA: gantt, hangar, analytics, …; пусто — первый доступный.
  homePage           String?
  /// kind[] колокольчика, которые пользователь скрыл: EVENT_OVERDUE_NO_FACT, …
  mutedNotificationKinds Json @default("[]")

  roles UserRole[]

  ownedSandboxes     Sandbox[]             @relation("SandboxOwner")
  sandboxMemberships SandboxMember[]
  activityLogs       UserActivityLog[]
  presenceEvents     UserPresenceEvent[]
  ownedReports       SavedReport[]         @relation("ReportOwner")
  reportShares       SavedReportShare[]
  savedTableViews          SavedTableView[]
  notificationReads        AppNotificationRead[]
  authoredAnnouncements    AppAnnouncement[] @relation("AnnouncementAuthor")
  announcementDismissals   AppAnnouncementDismissal[]

  @@index([isActive])
}

// Песочница плана: именованное изолированное пространство для «игры» с планом
model Sandbox {
  id                String             @id @default(uuid())
  name              String
  description       String?
  status            SandboxStatus      @default(ACTIVE)
  ownerId           String
  sharedWithAllRole SandboxMemberRole?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  owner   User            @relation("SandboxOwner", fields: [ownerId], references: [id])
  members SandboxMember[]

  events               MaintenanceEvent[]
  placements           EventPlacement[]
  reservations         StandReservation[]
  towSegments          EventTow[]
  auditTrail           MaintenanceEventAudit[]
  workPlanLines        EventWorkPlanLine[]
  workActualLines      EventWorkActualLine[]
  timeEntries          TimeEntry[]
  materialReservations MaterialReservation[]
  materialIssues       MaterialIssue[]
  stockMovements       StockMovement[]
  technicalPlans       EventTechnicalPlan[]
  technicalNeeds       EventTechnicalNeed[]
  technicalSteps       EventTechnicalStep[]
  primaryExtensions    EventPrimaryExtension[]
  customerSlots        EventCustomerSlot[]
  slotDeviations       EventSlotDeviation[]
  reportMetrics        EventReportMetric[]
  reportScalars        EventReportScalar[]
  ptoRollingEntries    EventPtoRollingEntry[]
  aCheckAnalyses       EventACheckAnalysis[]

  @@index([ownerId])
  @@index([status])
}

model SandboxMember {
  sandboxId String
  userId    String
  role      SandboxMemberRole @default(EDITOR)
  addedAt   DateTime          @default(now())

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sandboxId, userId])
  @@index([userId])
}

model Role {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Operator {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aircraft Aircraft[]
  palettes AircraftTypePalette[]
}

model AircraftType {
  id           String    @id @default(uuid())
  icaoType     String?   @unique
  name         String
  manufacturer String?
  bodyType     BodyType? // узкий/широкий фюзеляж — для подбора варианта расстановки
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  aircraft               Aircraft[]
  palettes               AircraftTypePalette[]
  hangarStandRules       HangarStandAircraftType[]
  placementPriorityRules PlacementPriorityRuleAircraftType[]
}

// Палитра: цвет для связки "оператор + тип ВС"
model AircraftTypePalette {
  id             String   @id @default(uuid())
  operatorId     String
  aircraftTypeId String
  // hex, например #f59e0b
  color          String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operator     Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  aircraftType AircraftType @relation(fields: [aircraftTypeId], references: [id], onDelete: Cascade)

  @@unique([operatorId, aircraftTypeId])
  @@index([operatorId])
  @@index([aircraftTypeId])
  @@index([isActive])
}

model Aircraft {
  id              String    @id @default(uuid())
  tailNumber      String    @unique
  serialNumber    String?
  manufactureDate DateTime? // дата производства ВС (день); возраст считается на клиенте/в UI
  operatorId      String
  typeId          String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  operator Operator     @relation(fields: [operatorId], references: [id])
  type     AircraftType @relation(fields: [typeId], references: [id])

  events MaintenanceEvent[]

  @@index([operatorId])
  @@index([typeId])
}

model EventType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  color     String? // hex, например #3b82f6
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events                 MaintenanceEvent[]
  placementPriorityRules PlacementPriorityRuleEventType[]
}

/// Редактируемые подписи и палитра статусов события. Код = enum EventStatus (логика планирования).
model EventStatusCatalog {
  code                 EventStatus @id
  name                 String
  /// hex полоски на Гантте, например #FFC182; пусто — без полоски
  color                String?
  sortOrder            Int         @default(0)
  selectable           Boolean     @default(true)
  /// После опер. начала автоматически переводить во «В работе»
  allowsAutoInProgress Boolean     @default(false)
  /// Автоматика не трогает (нет авто «В работе» и просрочки без факта)
  manualOnly           Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([sortOrder])
}

model Workshop {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  /// Дефолтный контур L/B для событий этого цеха
  defaultLineBase EventLineBase?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  events MaintenanceEvent[]

  @@index([isActive])
}

model Hangar {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  /// Код станции выполнения ТО (например SVO, REN)
  station    String?
  /// false = внешний MRO / «сторонний» контур (не физический ангар площадки)
  isPhysical Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  layouts                HangarLayout[]
  events                 MaintenanceEvent[]
  placements             EventPlacement[]
  placementPriorityRules PlacementPriorityRule[]
}

model HangarLayout {
  id           String   @id @default(uuid())
  hangarId     String
  code         String
  name         String
  description  String?
  // Геометрия площади (для базовой визуализации)
  widthMeters  Float?
  heightMeters Float?
  // Препятствия на плане: массив { type: "rect", x, y, w, h } в метрах (колонны, стены и т.д.)
  obstacles    Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hangar Hangar        @relation(fields: [hangarId], references: [id])
  stands HangarStand[]

  reservations           StandReservation[]
  events                 MaintenanceEvent[]
  placements             EventPlacement[]
  placementPriorityRules PlacementPriorityRule[]

  @@unique([hangarId, code])
  @@index([hangarId])
}

model HangarStand {
  id       String    @id @default(uuid())
  layoutId String
  code     String
  name     String
  // Deprecated: совместимость теперь задаётся через HangarStandAircraftType.
  bodyType BodyType?

  // Прямоугольник места в координатах "метры" (простой SVG план)
  x      Float
  y      Float
  w      Float
  h      Float
  rotate Float @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  layout                 HangarLayout              @relation(fields: [layoutId], references: [id])
  allowedAircraftTypes   HangarStandAircraftType[]
  reservations           StandReservation[]
  placements             EventPlacement[]
  placementPriorityRules PlacementPriorityRule[]

  @@unique([layoutId, code])
  @@index([layoutId])
}

model HangarStandAircraftType {
  standId        String
  aircraftTypeId String
  createdAt      DateTime @default(now())

  stand        HangarStand  @relation(fields: [standId], references: [id], onDelete: Cascade)
  aircraftType AircraftType @relation(fields: [aircraftTypeId], references: [id], onDelete: Cascade)

  @@id([standId, aircraftTypeId])
  @@index([aircraftTypeId])
}

model PlacementPriorityRule {
  id                     String   @id @default(uuid())
  hangarId               String
  layoutId               String
  standId                String
  priorityScore          Int      @default(500)
  sourceEventName        String?
  sourceAircraftTypeText String?
  conditionText          String?
  comment                String?
  source                 String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  hangar Hangar       @relation(fields: [hangarId], references: [id])
  layout HangarLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  stand  HangarStand  @relation(fields: [standId], references: [id], onDelete: Cascade)

  eventTypes    PlacementPriorityRuleEventType[]
  aircraftTypes PlacementPriorityRuleAircraftType[]

  @@index([hangarId])
  @@index([layoutId])
  @@index([standId])
  @@index([isActive])
}

model PlacementPriorityRuleEventType {
  ruleId      String
  eventTypeId String
  createdAt   DateTime @default(now())

  rule      PlacementPriorityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventType EventType             @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@id([ruleId, eventTypeId])
  @@index([eventTypeId])
}

model PlacementPriorityRuleAircraftType {
  ruleId         String
  aircraftTypeId String
  createdAt      DateTime @default(now())

  rule         PlacementPriorityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  aircraftType AircraftType          @relation(fields: [aircraftTypeId], references: [id], onDelete: Cascade)

  @@id([ruleId, aircraftTypeId])
  @@index([aircraftTypeId])
}

model OptimizationProfile {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules OptimizationScoreRule[]

  @@index([isActive])
  @@index([isDefault])
}

model OptimizationScoreRule {
  id        String                    @id @default(uuid())
  profileId String
  code      String
  name      String
  category  OptimizationScoreCategory
  scope     OptimizationScoreScope
  value     Float
  unit      OptimizationScoreUnit
  isActive  Boolean                   @default(true)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  profile OptimizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, code])
  @@index([profileId])
  @@index([category])
  @@index([scope])
  @@index([isActive])
}

model MaintenanceEvent {
  id           String            @id @default(uuid())
  level        PlanningLevel
  status       EventStatus       @default(PENDING_EXECUTOR_APPROVAL)
  planningKind EventPlanningKind @default(PLANNED)
  title        String

  // контекст планирования: null = рабочий контур, иначе — песочница
  sandboxId String?

  aircraftId  String? // null при виртуальном борте (массовое планирование)
  eventTypeId String

  // Виртуальный борт: заполняется при массовом планировании; при закрытии события создаётся Aircraft и сюда записывается aircraftId
  virtualAircraft Json? // { operatorId, aircraftTypeId, label }

  startAt       DateTime
  endAt         DateTime
  budgetStartAt DateTime?
  budgetEndAt   DateTime?
  actualStartAt DateTime?
  actualEndAt   DateTime?

  // Опционально можно заранее закрепить в ангаре/варианте (даже без конкретного места)
  hangarId String?
  layoutId String?

  // Цех (справочник) — одинарный выбор
  workshopId String?

  /// Контур ТО L (Line) / B (Base). Авто из цеха, можно переопределить вручную.
  lineBase EventLineBase?

  notes String?

  /// Событие уже размещалось с нахлёстом: при следующих сохранениях конфликт слота не блокирует запись.
  allowOverlap Boolean @default(false)

  // Lineage: связь копии с источником (для merge/dedup между песочницами)
  // originEventId — корень в рабочем контуре (null = событие создано с нуля или само является корнем в prod)
  // sourceEventId — непосредственный родитель при копировании
  // sourceSandboxId — песочница-источник (null = скопировано из рабочего контура)
  originEventId   String?
  sourceEventId   String?
  sourceSandboxId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aircraft  Aircraft? @relation(fields: [aircraftId], references: [id])
  eventType EventType @relation(fields: [eventTypeId], references: [id])

  hangar   Hangar?       @relation(fields: [hangarId], references: [id])
  layout   HangarLayout? @relation(fields: [layoutId], references: [id])
  workshop Workshop?     @relation(fields: [workshopId], references: [id])
  sandbox  Sandbox?      @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  reservations StandReservation[]
  placements   EventPlacement[]
  auditTrail   MaintenanceEventAudit[]
  towSegments  EventTow[]

  workPlanLines        EventWorkPlanLine[]
  workActualLines      EventWorkActualLine[]
  timeEntries          TimeEntry[]
  materialReservations MaterialReservation[]
  materialIssues       MaterialIssue[]
  stockMovements       StockMovement[]
  technicalPlan        EventTechnicalPlan?
  notifications        AppNotification[]
  primaryExtension     EventPrimaryExtension?
  customerSlot         EventCustomerSlot?
  slotDeviations       EventSlotDeviation[]
  reportMetrics        EventReportMetric[]
  reportScalars        EventReportScalar[]
  ptoRollingEntries    EventPtoRollingEntry[]
  aCheckAnalysis       EventACheckAnalysis?

  @@index([aircraftId])
  @@index([eventTypeId])
  @@index([startAt, endAt])
  @@index([planningKind])
  @@index([hangarId])
  @@index([layoutId])
  @@index([workshopId])
  @@index([lineBase])
  @@index([sandboxId])
  @@index([sandboxId, startAt, id])
  @@index([originEventId, sandboxId])
  @@index([sourceEventId])
}

model EventPrimaryExtension {
  id                   String   @id @default(uuid())
  eventId              String   @unique
  sandboxId            String?
  fleetCode            String?
  externalExecution    Boolean?
  normalizedForm       String?
  normalizedFormDetail String?
  stationCode          String?
  phaseKind            String?
  agreementStatus      String?
  iiCCheckFact         Boolean?
  wpNumberFact         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([sandboxId])
  @@index([fleetCode])
  @@index([normalizedForm])
}

model EventCustomerSlot {
  id        String    @id @default(uuid())
  eventId   String    @unique
  sandboxId String?
  startAt   DateTime?
  endAt     DateTime?
  dlFlag    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([sandboxId])
  @@index([startAt, endAt])
}

model EventSlotDeviation {
  id        String   @id @default(uuid())
  eventId   String
  sandboxId String?
  kind      String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind])
  @@index([sandboxId])
  @@index([kind])
}

model EventReportMetric {
  id         String                  @id @default(uuid())
  eventId    String
  sandboxId  String?
  block      PrimaryMetricBlock
  department PrimaryMetricDepartment
  manHours   Decimal?                @db.Decimal(18, 4)
  costAmount Decimal?                @db.Decimal(18, 4)
  currency   String?
  source     PrimaryMetricSource     @default(MANUAL)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([eventId, block, department])
  @@index([sandboxId, block])
  @@index([eventId])
}

model EventReportScalar {
  id        String   @id @default(uuid())
  eventId   String
  sandboxId String?
  metricKey String
  valueNum  Decimal? @db.Decimal(18, 4)
  valueText String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([eventId, metricKey])
  @@index([sandboxId, metricKey])
  @@index([eventId])
}

model EventPtoRollingEntry {
  id          String   @id @default(uuid())
  eventId     String
  sandboxId   String?
  externalKey String?
  status      String?
  kippHours   Decimal? @db.Decimal(18, 4)
  laborTotal  Decimal? @db.Decimal(18, 4)
  amount      Decimal? @db.Decimal(18, 4)
  category    String?
  comments    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sandboxId])
  @@index([externalKey])
}

model EventACheckAnalysis {
  id        String   @id @default(uuid())
  eventId   String   @unique
  sandboxId String?
  status    String?
  quantity  Int?
  program   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([sandboxId])
}

model EventTechnicalPlan {
  id           String              @id @default(uuid())
  eventId      String              @unique
  sandboxId    String?
  status       TechnicalPlanStatus @default(DRAFT)
  leadEngineer String?
  readinessPct Int                 @default(0)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  needs EventTechnicalNeed[]
  steps EventTechnicalStep[]

  @@index([sandboxId])
  @@index([status])
}

model EventTechnicalNeed {
  id          String                @id @default(uuid())
  planId      String
  sandboxId   String?
  category    TechnicalNeedCategory
  description String
  quantity    String?
  requiredAt  DateTime?
  responsible String?
  status      TechnicalNeedStatus   @default(NEEDED)
  isBlocker   Boolean               @default(false)
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  plan    EventTechnicalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sandbox Sandbox?           @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([sandboxId])
  @@index([status])
  @@index([category])
}

model EventTechnicalStep {
  id             String              @id @default(uuid())
  planId         String
  sandboxId      String?
  seq            Int                 @default(0)
  title          String
  description    String?
  responsible    String?
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  actualStartAt  DateTime?
  actualEndAt    DateTime?
  status         TechnicalStepStatus @default(NOT_STARTED)
  progressPct    Int                 @default(0)
  isBlocker      Boolean             @default(false)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  plan    EventTechnicalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sandbox Sandbox?           @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  predecessors EventTechnicalStepDependency[] @relation("StepDependencySuccessor")
  successors   EventTechnicalStepDependency[] @relation("StepDependencyPredecessor")

  @@index([planId, seq])
  @@index([sandboxId])
  @@index([status])
}

model EventTechnicalStepDependency {
  predecessorStepId String
  successorStepId   String

  predecessor EventTechnicalStep @relation("StepDependencyPredecessor", fields: [predecessorStepId], references: [id], onDelete: Cascade)
  successor   EventTechnicalStep @relation("StepDependencySuccessor", fields: [successorStepId], references: [id], onDelete: Cascade)

  @@id([predecessorStepId, successorStepId])
  @@index([successorStepId])
}

// Этапы размещения одного события по ангарам/местам.
// Один MaintenanceEvent остаётся логическим событием, а placements описывают,
// где и когда выполнялась работа при перебуксировках между ангарами.
model EventPlacement {
  id            String               @id @default(uuid())
  eventId       String
  sandboxId     String?
  origin        EventPlacementOrigin @default(MANUAL)
  startAt       DateTime
  endAt         DateTime
  budgetStartAt DateTime?
  budgetEndAt   DateTime?
  actualStartAt DateTime?
  actualEndAt   DateTime?
  hangarId      String?
  layoutId      String?
  standId       String?
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  hangar  Hangar?          @relation(fields: [hangarId], references: [id])
  layout  HangarLayout?    @relation(fields: [layoutId], references: [id])
  stand   HangarStand?     @relation(fields: [standId], references: [id])

  reservation StandReservation?

  @@index([eventId, sortOrder])
  @@index([sandboxId])
  @@index([origin])
  @@index([hangarId])
  @@index([layoutId])
  @@index([standId, startAt, endAt])
}

// Буксировки (закатка/выкатка) как интервалы внутри события (могут быть несколько раз)
model EventTow {
  id        String   @id @default(uuid())
  eventId   String
  sandboxId String?
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([eventId, startAt])
  @@index([sandboxId])
}

/// Уведомления (колокольчик): просрочка без факта, ошибки пользователей (только админам) и др.
model AppNotification {
  id        String   @id @default(uuid())
  /// EVENT_OVERDUE_NO_FACT | EVENT_STATUS_IN_PROGRESS | EVENT_STATUS_DONE | USER_ERROR
  kind      String
  title     String
  body      String?
  eventId   String?
  sandboxId String?
  /// Уникальный ключ дедупликации, напр. overdue:<eventId>
  dedupeKey String   @unique
  createdAt DateTime @default(now())

  event MaintenanceEvent?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reads AppNotificationRead[]

  @@index([createdAt])
  @@index([eventId])
  @@index([kind, createdAt])
}

model AppNotificationRead {
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
}

/// Системные объявления админов: обновления, ограничения, приостановки на период.
model AppAnnouncement {
  id          String    @id @default(uuid())
  /// UPDATE | CHANGE | MAINTENANCE | OUTAGE
  kind        String
  title       String
  body        String
  /// Начало периода ограничения/приостановки (информативно; показ сразу после публикации)
  startsAt    DateTime?
  /// Окончание периода: после этой даты объявление скрывается само
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy  User?                       @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  dismissals AppAnnouncementDismissal[]

  @@index([isActive, createdAt])
  @@index([endsAt])
}

model AppAnnouncementDismissal {
  announcementId String
  userId         String
  dismissedAt    DateTime @default(now())

  announcement AppAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

model MaintenanceEventAudit {
  id        String           @id @default(uuid())
  eventId   String
  sandboxId String?
  action    EventAuditAction
  actor     String           @default("browser")
  reason    String?
  // хранит diff вида { field: { from: any, to: any } }
  changes   Json?
  createdAt DateTime         @default(now())

  event   MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sandbox Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([sandboxId])
  @@index([actor, createdAt])
}

/// Журнал действий пользователя вне конкретного события (песочницы, массовая очистка).
/// Не привязан FK к Sandbox, чтобы записи переживали удаление песочницы.
model UserActivityLog {
  id          String             @id @default(uuid())
  userId      String?
  actor       String
  action      UserActivityAction
  reason      String?
  title       String?
  /// Снимок: "prod" | "sandbox"
  sourceKind  String             @default("prod")
  sandboxId   String?
  sandboxName String?
  changes     Json?
  createdAt   DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([actor, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Лёгкий журнал присутствия: входы и переходы по разделам (не каждый клик).
model UserPresenceEvent {
  id        String   @id @default(uuid())
  userId    String
  /// LOGIN | PAGE | ACTION
  kind      String
  /// Раздел SPA: gantt, hangar, analytics, ...
  page      String?
  detail    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Singleton SMTP. Содержание рассылок — в MailDigestVariant.
model MailDigestSettings {
  id         String   @id @default("default")
  smtpHost   String?
  smtpPort   Int      @default(465)
  smtpSecure Boolean  @default(true)
  smtpUser   String?
  smtpPass   String?
  mailFrom   String?
  updatedAt  DateTime @updatedAt
}

/// Сохранённый вариант рассылки (тема, период, колонки, получатели, расписание).
model MailDigestVariant {
  id               String   @id @default(uuid())
  name             String
  /// Тема письма; пустая — берётся name
  subjectTemplate  String   @default("Изменения плана ТО")
  description      String?
  /// string[] — список email получателей
  recipients       Json     @default("[]")
  /// last1 | last7 | last30 | custom
  periodMode       String   @default("last7")
  periodCustomFrom String?
  periodCustomTo   String?
  /// manual | daily | weekly | monthly
  scheduleMode     String   @default("manual")
  /// HH:mm, время по МСК
  scheduleTime     String   @default("09:00")
  /// number[] ISO weekday 1=Пн … 7=Вс
  scheduleWeekdays Json     @default("[1,2,3,4,5]")
  scheduleMonthDay Int      @default(1)
  isActive         Boolean  @default(true)
  lastAutoSentAt   DateTime?
  /// string[] — колонки письма (см. mailDigestColumns)
  columns          Json     @default("[\"kind\",\"aircraftType\",\"aircraft\",\"title\",\"detail\",\"previous\"]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sendLogs         MailDigestSendLog[]

  @@index([updatedAt])
}

/// История отправок дайджеста (ручных и по расписанию).
model MailDigestSendLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  variantId   String?
  /// Снимок названия на момент отправки
  variantName String?
  /// SENT | FAILED | EMPTY
  status      String
  /// self | all | schedule
  target      String
  actorEmail  String?
  recipients  Json     @default("[]")
  subject     String
  error       String?
  stats       Json?
  periodFrom  DateTime?
  periodTo    DateTime?

  variant MailDigestVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([variantId, createdAt])
}

model StandReservation {
  id String @id @default(uuid())

  // Резервирование привязано к событию и, для многоангарных событий, к конкретному этапу.
  eventId     String
  placementId String? @unique
  sandboxId   String?
  layoutId    String
  standId     String

  // Диапазон резерва (может совпадать с event.startAt/endAt или отличаться)
  startAt DateTime
  endAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     MaintenanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  placement EventPlacement?  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  layout    HangarLayout     @relation(fields: [layoutId], references: [id])
  stand     HangarStand      @relation(fields: [standId], references: [id])
  sandbox   Sandbox?         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([layoutId])
  @@index([standId, startAt, endAt])
  @@index([sandboxId])
}

/// Пользовательский отчёт конструктора аналитики (СКД-подобный конфиг в JSON).
model SavedReport {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  /// NULL = только владелец и явно добавленные участники.
  sharedWithAllRole ReportShareRole?
  /// { dataset, fields[], filters, sort[], grain?, compareA?, compareB?, periodMode?, freezeRows?, showColumnIndex? }
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User               @relation("ReportOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shares SavedReportShare[]

  @@index([ownerId])
  @@index([updatedAt])
}

model SavedReportShare {
  reportId String
  userId   String
  role     ReportShareRole @default(VIEWER)
  addedAt  DateTime        @default(now())

  report SavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@index([userId])
}

/// Именованный набор столбцов таблицы (порядок, видимость, ширины) на пользователя.
model SavedTableView {
  id        String   @id @default(uuid())
  userId    String
  tableKey  String
  name      String
  isActive  Boolean  @default(false)
  /// { order: string[], hidden: string[], widths: Record<string, number> }
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey, name])
  @@index([userId, tableKey])
}

/// Синглтон техрежима контура (id = default).
model AppRuntimeConfig {
  id           String   @id
  writeBlocked Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  updatedById  String?
}
